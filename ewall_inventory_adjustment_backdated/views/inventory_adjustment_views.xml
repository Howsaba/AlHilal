<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Insert new fields for stock.quant inside the form sheet -->
    <record id="view_quant_tree_inherited" model="ir.ui.view">
        <field name="name">stock.quant.tree.inventory.backdated.notes</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/> <!-- Correct xml_id for the tree view -->
        <field name="arch" type="xml">
            <!-- Adjust xpath to include new fields in the tree view -->
            <xpath expr="//field[@name='inventory_date']" position="after">
                <field name="inventory_backdated" optional="show"/>
                <field name="notes" optional="show" required="inventory_backdated != False"/>
            </xpath>
        </field>
    </record>
    <!-- Insert new fields for stock.move inside the form sheet -->
    <record id="view_stock_move_form_inherited" model="ir.ui.view">
        <field name="name">stock.move.form.inherited</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="inventory_backdated" invisible="1"/>
                <field name="notes" readonly="1" invisible="inventory_backdated == False"/>
            </field>
        </field>
    </record>
    <!-- Insert new fields for stock.move.line inside the form sheet -->
    <record id="view_stock_move_line_form_inherited" model="ir.ui.view">
        <field name="name">stock.move.line.form.inherited</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="inventory_backdated" invisible="1"/>
                <field name="notes" readonly="1" invisible="inventory_backdated == False"/>
            </field>
        </field>
    </record>
    <!-- Insert new fields for stock.valuation.layer inside the form sheet -->
    <record id="view_stock_valuation_layer_form_inherited" model="ir.ui.view">
        <field name="name">stock.valuation.layer.form.inherited</field>
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.stock_valuation_layer_form"/>
        <field name="arch" type="xml">
            <field name="create_date" position="after">
                <field name="inventory_backdated" invisible="1"/>
                <field name="notes" readonly="1" invisible="inventory_backdated == False"/>
            </field>
        </field>
    </record>
    <!-- Insert new fields for account.move inside the form sheet -->
    <record id="view_account_move_form_inherited" model="ir.ui.view">
        <field name="name">account.move.form.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']/field[@name='date']" position="after">
                <field name="inventory_backdated" invisible="1"/>
                <field name="notes" readonly="1" invisible="inventory_backdated == False"/>
            </xpath>
        </field>
    </record>
</odoo>