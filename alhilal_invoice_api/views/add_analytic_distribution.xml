<odoo>
  <record id="view_res_branch_form_custom" model="ir.ui.view">
    <field name="name">res.branch.form.inherit.analytic</field>
    <field name="model">res.branch</field>
    <field name="inherit_id" ref="subscriptions_modification.res_branch_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='company_id']" position="after">
        <field name="sales_analytic_distributions" widget="many2many_tags" required="1" />
      </xpath>
    </field>
  </record>
</odoo>