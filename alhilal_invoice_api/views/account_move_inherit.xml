<odoo>
  <record id="view_move_form_custom" model="ir.ui.view">
    <field name="name">account.move.form.inherit.membership</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_shipping_id']" position="before">
        <field name="membership_plan_id" readonly="1" />
        <field name="subscription_type" readonly="1" />
      </xpath>
    </field>
  </record>


  <record id="view_move_tree_custom" model="ir.ui.view">
    <field name="name">account.move.tree.inherit.membership</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_out_invoice_tree" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='invoice_date']" position="after">
        <field name="membership_plan_id" optional="hide" />
        <field name="subscription_type" optional="hide" />
      </xpath>
    </field>
  </record>

  <record id="account_move_filter_custom" model="ir.ui.view">
    <field name="name">account.move.search.inherit.membership</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_account_invoice_filter" />
    <field name="arch" type="xml">
      <xpath expr="//filter[@name='to_check']" position="after">
        <separator />
        <filter name="membership_plan_id" string="Membership Plan"
          context="{'group_by':'membership_plan_id'}" />
        <filter name="subscription_type" string="Subscription Type"
          context="{'group_by':'subscription_type'}" />
      </xpath>
    </field>
  </record>
</odoo>